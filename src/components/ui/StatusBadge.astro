---
import { statusLabels, type Status } from '../../config/labels';
import OutlineIcon from './OutlineIcon.astro';

interface Props {
	status: Status;
}

const { status } = Astro.props;
const icon = status === 'verified' ? 'check' : status === 'investigating' ? 'info' : 'alert';
---

<span class:list={['status-badge', `status-${status}`]}>
	<OutlineIcon name={icon} size={14} />
	{statusLabels[status]}
</span>
